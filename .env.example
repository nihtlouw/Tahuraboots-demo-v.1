# ─────────────────────────────────────────────────────────────────────
#  Salin file ini menjadi .env:
#      cp .env.example .env
#  lalu isi nilainya. File .env TIDAK boleh di-commit (sudah di-gitignore).
# ─────────────────────────────────────────────────────────────────────

# ── Database (Neon Postgres) ─────────────────────────────────────────
# Runtime aplikasi memakai host dengan akhiran "-pooler".
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Koneksi langsung (tanpa "-pooler") untuk migration/push drizzle-kit.
# Kalau dikosongkan, drizzle.config.ts otomatis memakai DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ── CRM ──────────────────────────────────────────────────────────────
# Passcode untuk masuk ke /crm. WAJIB diganti sebelum deploy.
CRM_PASSCODE="ganti-passcode-ini"
